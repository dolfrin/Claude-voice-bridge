# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Supergroup with Topics enabled. Each project gets a control topic, and each
# agent session its own "<project> #N" sub-topic. Unset keeps everything in the
# allowed user's private chat.
# TELEGRAM_CHAT_ID=

# Model providers
OPENAI_API_KEY=
TOGETHER_API_KEY=
# Optional: set only if you want Claude pay-per-token API billing.
# Leave unset to use your local Claude Code subscription login.
# ANTHROPIC_API_KEY=

# Text-to-speech: auto uses Piper only for English-looking text,
# OpenAI for every other language or uncertain text.
TTS_BACKEND=auto
TTS_VOICE=alloy
TOGETHER_TTS_MODEL=cartesia/sonic
TOGETHER_TTS_LANGUAGE=auto
PIPER_VOICE_PATH=/opt/piper/en_US-voice.onnx

# Speech-to-text
WHISPER_MODEL=large-v3

# Autonomy / approvals
# auto (Claude Code decides, like the VS Code extension) | safe | full | ask
AUTONOMY_MODE=auto
APPROVAL_TIMEOUT=300

# Persistence
DB_PATH=/var/lib/voice-bridge/state.db

# Project discovery
AUTO_DISCOVER_PROJECTS=false
AUTO_DISCOVER_LIMIT=12
OPEN_VSCODE_ON_ENABLE=false
CLOSE_VSCODE_ON_DISABLE=false

# Claude Code session history, used by /resume, /sessions and /history. These
# are the same files the CLI and the VS Code extension read.
CLAUDE_PROJECTS_DIR=~/.claude/projects
CLAUDE_SESSIONS_DIR=~/.claude/sessions
RESUME_LIMIT=8
# /history browses everything on disk, so it lists more than the attach picker.
HISTORY_LIMIT=20

# Set so sessions started from Telegram stay visible in the VS Code session
# list; the SDK default (sdk-py) is filtered out of it.
CLAUDE_CODE_ENTRYPOINT=voice-bridge

# Live progress: while the agent works, one message per turn is edited in place
# with the tools it is running.
STREAM_PROGRESS=true
# Seconds between live progress edits. Lower means more Telegram edits per turn.
STREAM_INTERVAL=1.5
