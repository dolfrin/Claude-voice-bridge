# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Agent runtime: claude (default) or codex. /agent in Telegram rewrites this.
AGENT_BACKEND=claude

# Language the bot speaks to you: en (default) or lt.
BOT_LANGUAGE=en

# Allow /pc to suspend, shut down or restart this machine from Telegram.
PC_POWER_COMMANDS=false

# Save each Claude login seen on this PC so /account can switch back to it
# (Linux; the saved logins are live tokens, stored 0600 next to DB_PATH).
CLAUDE_ACCOUNT_SWITCHING=false

# Turning a project on (and /newproject) opens it in VS Code with a new Claude tab
# that your next Telegram message starts (needs xdotool, X11).
OPEN_CLAUDE_TAB_ON_ENABLE=false

# Model providers
OPENAI_API_KEY=
TOGETHER_API_KEY=
# Optional: set only if you want Claude pay-per-token API billing.
# Leave unset to use your local Claude Code subscription login.
# ANTHROPIC_API_KEY=

# Text-to-speech: auto, openai, piper, together, or lithuanian.
# auto uses Piper only for English-looking text,
# OpenAI for every other language or uncertain text.
TTS_BACKEND=auto
TTS_VOICE=alloy
# Optional distinct voice for ALERT-class TTS (approval questions + crash
# notices) so a walking user notices them. Falls back to TTS_VOICE if unset.
# TTS_ALERT_VOICE=shimmer
TOGETHER_TTS_MODEL=cartesia/sonic
TOGETHER_TTS_LANGUAGE=auto
PIPER_VOICE_PATH=/opt/piper/en_US-voice.onnx
# Directory with the Lithuanian reginute1 voice (TTS_BACKEND=lithuanian only)
# PIPER_LT_DIR=/opt/piper/lt_LT-reginute1

# Speech-to-text
WHISPER_MODEL=large-v3
# Force a transcription language (lt, en, ...); empty = auto-detect
# WHISPER_LANGUAGE=

# Autonomy / approvals
AUTONOMY_MODE=safe
APPROVAL_TIMEOUT=300

# Persistence
DB_PATH=/var/lib/voice-bridge/state.db

# Optional shared Codex app-server. With AGENT_BACKEND=codex this lets the
# Telegram bridge and Codex UI attach to the same server and thread.
# CODEX_APP_SERVER_URL=unix:///run/user/1000/codex-shared/app-server.sock

# Project discovery
AUTO_DISCOVER_PROJECTS=false
AUTO_DISCOVER_LIMIT=12
OPEN_VSCODE_ON_ENABLE=false
CLOSE_VSCODE_ON_DISABLE=false

# IDE catch-up: idle minutes before a project's next turn gets a git/session
# recap prepended (see README "Context sync (IDE <-> Telegram)")
CATCHUP_IDLE_MINUTES=10
